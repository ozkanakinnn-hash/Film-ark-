<?xml version="1.0" encoding="utf-8"?>
<!-- Yalnızca HTTPS: şifresiz (http://) bağlantılar engellenir. Sistem sertifikalarına güvenilir. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
